# Variables de identity-service/docker-compose.yml. Copiar a .env en esta carpeta (no se versiona)
# y completar; docker compose lo lee solo al correrlo desde aquí. Fuera de Docker:
#   set -a; . ./.env; set +a; mvn spring-boot:run
#
# En producción, los mismos nombres con otros valores (README, "Despliegue a producción").

# identity_db (contenedor identity-db)
IDENTITY_DB_USER=identity_svc
IDENTITY_DB_PASSWORD=identity_svc

# Redis y RabbitMQ son del proyecto infra: iguales a los de ../.env.
REDIS_PASSWORD=redis_dev
RABBITMQ_USER=transporte
RABBITMQ_PASSWORD=transporte

# Secreto HS256 del JWT: identity firma y el gateway verifica, así que es igual al de
# ../api-gateway/.env. Base64 de al menos 256 bits; generarlo con:  openssl rand -base64 32
# Obligatorio: sin él compose no arranca.
JWT_SECRET=

# Primer SYS_ADMIN: identity-service lo crea al arrancar si no existe ninguno. Después de
# creado, cambiar estas variables no hace nada (la contraseña se cambia con "olvidé mi contraseña").
ADMIN_CORREO=admin@transporte.gt
ADMIN_CONTRASENA=
